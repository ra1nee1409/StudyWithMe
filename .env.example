# ==============================================================================
# STUDYWITHME - MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Hướng dẫn: Sao chép file này thành ".env" tại thư mục gốc dự án và điền giá trị thật
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
# ==============================================================================

# Server
SERVER_PORT=8080

# Microsoft SQL Server
# Tùy chọn 1 (Mặc định): Windows Authentication (yêu cầu mssql-jdbc_auth.dll)
DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=studywithme_db;integratedSecurity=true;encrypt=true;trustServerCertificate=true
# Tùy chọn 2: Tài khoản SQL Server (sa) - bỏ comment 2 dòng dưới và trong application.properties
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=studywithme_db;encrypt=true;trustServerCertificate=true
# DB_USERNAME=sa
# DB_PASSWORD=your_sql_server_password

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# MongoDB (Chat Realtime - dùng localhost hoặc MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/studywithme_chat
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studywithme_chat?retryWrites=true&w=majority

# JWT Authentication (chuỗi bí mật >= 32 ký tự)
JWT_SECRET=change_this_to_a_strong_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# Cổng thanh toán VietQR PayOS (đăng ký tại https://my.payos.vn)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:8080/payment/payos-callback
PAYOS_CANCEL_URL=http://localhost:8080/checkout?cancel=true

# Nạp dữ liệu mẫu khi khởi động lần đầu (true/false)
APP_SEED_SAMPLE_DATA=false
