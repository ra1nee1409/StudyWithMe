# ==============================================================================
# STUDYWITHME API - TEMPLATE CẤU HÌNH MẪU (APPLICATION PROPERTIES EXAMPLE)
# Hướng dẫn: Sao chép file này thành application.properties và điều chỉnh thông tin
# ==============================================================================
spring.application.name=studywithme-api
server.port=8080

# ==============================================================================
# CẤU HÌNH DATASOURCE MICROSOFT SQL SERVER
# ==============================================================================
# Tùy chọn 1: Windows Authentication (Mặc định - Yêu cầu thư viện mssql-jdbc_auth.dll)
spring.datasource.url=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=studywithme_db;integratedSecurity=true;encrypt=true;trustServerCertificate=true
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

# Tùy chọn 2: Xác thực bằng tài khoản sa (Bỏ comment nếu dùng user/password SQL Server)
# spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=studywithme_db;encrypt=true;trustServerCertificate=true
# spring.datasource.username=sa
# spring.datasource.password=your-password-here

# Cấu hình Connection Pool HikariCP
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.maximum-pool-size=15
spring.datasource.hikari.idle-timeout=30000
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.connection-timeout=15000

# Tối ưu hóa Tomcat Thread Pool & Gzip Nén Dữ Liệu HTTP
server.tomcat.threads.max=150
server.tomcat.threads.min-spare=20
server.tomcat.max-connections=8192
server.tomcat.accept-count=100
server.tomcat.connection-timeout=20000

server.compression.enabled=true
server.compression.min-response-size=1024
server.compression.mime-types=text/html,text/xml,text/plain,text/css,text/javascript,application/javascript,application/json

spring.web.resources.cache.cachecontrol.max-age=3600s
spring.web.resources.cache.cachecontrol.cache-public=true

# Cấu hình JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# ==============================================================================
# CẤU HÌNH MONGODB (CHAT & REAL-TIME MESSAGING)
# ==============================================================================
# Tùy chọn 1: MongoDB cục bộ (Localhost)
spring.mongodb.uri=mongodb://localhost:27017/studywithme_chat

# Tùy chọn 2: Cụm đám mây MongoDB Atlas Cloud (Bỏ comment và thay chuỗi kết nối)
# spring.mongodb.uri=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/studywithme_chat?retryWrites=true&w=majority

# Cấu hình Upload File
spring.servlet.multipart.max-file-size=100MB
spring.servlet.multipart.max-request-size=100MB

# Cấu hình Jackson JSON
spring.jackson.deserialization.fail-on-unknown-properties=false

# ==============================================================================
# CẤU HÌNH CỔNG THANH TOÁN TỰ ĐỘNG VIETQR PAYOS
# Đăng ký và lấy thông tin tại https://my.payos.vn
# ==============================================================================
payos.client-id=your-client-id-here
payos.api-key=your-api-key-here
payos.checksum-key=your-checksum-key-here
payos.return-url=http://localhost:8080/payment/payos-callback
payos.cancel-url=http://localhost:8080/checkout?cancel=true
